APP_NAME=Rullē
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Riga

CASHIER_CURRENCY=eur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# The one SQLite path, relative to the project root. In Docker that is
# /var/www/html/storage/app/database.sqlite, which sits inside the
# `app_storage` volume - the same value is pinned in docker-compose.yml and
# docker/entrypoint.sh, so all three must agree. Backups go to
# storage/app/backups (their own volume in Docker).
DB_DATABASE=storage/app/database.sqlite

# Plain files, not the database: every single request writes to its
# session (even a guest just viewing the public livestream page), so
# 'database' meant every request on the entire site was a writer against
# the same SQLite file, all serialized behind each other regardless of WAL
# mode - confirmed directly: a concurrent request to a page that touches no
# app data at all still measurably waited behind an unrelated write. Each
# session is its own file here, so different visitors' session writes never
# contend with each other, or with real app-data writes, at all.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Unset locally (plain http://localhost); the deploy pipeline forces this to
# true in production, since the site is only ever served over https there.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Kept as flat literals (not "${REVERB_PORT}"-style) rather than sharing
# REVERB_PORT/REVERB_SCHEME above, because in production they point at
# different things: REVERB_PORT/SCHEME above is where the app privately
# reaches the Reverb server (inside Docker), while these are what the
# browser publicly connects to (through Cloudflare, on 443/https). Also,
# Docker Compose's own env-file parsing (used for the build args in
# docker-compose.yml) doesn't expand "${VAR}"-style references the way
# PHP's dotenv does, so these need to be literal here regardless.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Plain files, not the database: cache writes don't need to share the same
# SQLite file (and its whole-file write lock) as sessions and app data -
# keeping them separate means a cache write can never be part of what stalls
# an unrelated request.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Full RTSP URL for the park's Reolink camera, e.g.
# rtsp://user:pass@192.168.1.50:554/h264Preview_01_sub - see the
# "Livestream" section of the README. Left blank locally; set as a real
# secret in production.
CAMERA_RTSP_URL=

VITE_APP_NAME="${APP_NAME}"
